# AI Mock Assessment Service Configuration
# Add your AI API credentials here. These are NEVER sent to the frontend.
# The frontend reads VITE_AI_* variables only to talk to your own backend proxy.

# ── Option A: Direct AI API (e.g. Google Gemini, OpenAI) ─────────────────────
# Set this to the base URL of the AI provider REST API
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=YOUR_AI_API_KEY_HERE

# ── Option B: Your own FastAPI proxy (recommended for production) ─────────────
# Point the frontend to your own backend that holds the real key server-side
# Set USE_BACKEND_PROXY=true and provide the proxy URL below
USE_BACKEND_PROXY=false
AI_PROXY_URL=http://127.0.0.1:8000/api/ai

# ── Vite exposes only VITE_* vars to the browser ─────────────────────────────
# The frontend uses this URL to reach YOUR backend proxy (safe — no key exposed)
VITE_AI_PROXY_URL=http://127.0.0.1:8000/api/ai

# Model to use (e.g. gemini-1.5-flash, gpt-4o-mini)
AI_MODEL=gemini-1.5-flash
VITE_AI_MODEL=gemini-1.5-flash
